# ==============================================================================
# AI-Powered Document Intelligence System - Environment Configuration
# ==============================================================================

# Application
APP_NAME="AI Document Intelligence"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-jwt-encryption-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default for Docker Compose with Postgres + pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/doc_intelligence
# Fallback for local standalone development without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# File Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# FREE LLM API OPTIONS (Choose one):
# ------------------------------------------------------------------------------
# OPTION 1: Google Gemini (100% Free at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-free-gemini-api-key-here
LLM_MODEL=gemini-flash-lite-latest

# OPTION 2: Groq Cloud (100% Free & Fast at https://console.groq.com/keys)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your-free-groq-api-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# OPTION 3: OpenRouter (Free tier models at https://openrouter.ai/keys)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-your-free-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OPTION 4: Local Ollama (100% Free & Offline on your machine)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# OPTION 5: OpenAI (Paid)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_MODEL=gpt-4o

# Rate Limiting
RATE_LIMIT_UPLOAD="30/minute"
RATE_LIMIT_API="120/minute"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
