# ==============================================================================
# AI-Powered Document Intelligence System - Environment Configuration
# ==============================================================================

# Application
APP_NAME="AI Document Intelligence"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-jwt-encryption-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default for Docker Compose with Postgres + pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/doc_intelligence
# Fallback for local standalone development without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# When running standalone without Redis, Celery will run in eager mode:
CELERY_TASK_ALWAYS_EAGER=false

# File Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# AI / OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OCR Settings
TESSERACT_CMD=tesseract
POPPLER_PATH=

# Rate Limiting
RATE_LIMIT_UPLOAD="30/minute"
RATE_LIMIT_API="120/minute"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
